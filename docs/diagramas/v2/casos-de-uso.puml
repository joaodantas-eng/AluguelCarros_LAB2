@startuml casos-de-uso
title Sistema de Aluguel de Carros - Casos de Uso (v2 - revisado)
left to right direction
skinparam packageStyle rectangle

actor "Usuário" as Usuario
actor "Cliente" as Cliente
actor "Agente" as Agente
actor "Empresa" as Empresa
actor "Banco" as Banco

Usuario <|-- Cliente
Usuario <|-- Agente
Agente <|-- Empresa
Agente <|-- Banco

rectangle "Sistema de Aluguel de Carros" {
  usecase "UC01 Realizar login" as UC01
  usecase "UC02 Cadastrar-se" as UC02
  usecase "UC03 Manter dados pessoais\n(consultar, alterar, excluir conta)" as UC03
  usecase "UC04 Introduzir pedido" as UC04
  usecase "UC05 Consultar pedidos / status" as UC05
  usecase "UC06 Modificar pedido" as UC06
  usecase "UC07 Cancelar pedido" as UC07
  usecase "UC08 Avaliar pedido\n(parecer financeiro)" as UC08
  usecase "UC09 Executar contrato" as UC09
  usecase "UC10 Conceder crédito" as UC10
  usecase "UC11 Manter automóveis" as UC11
  usecase "UC12 Consultar clientes" as UC12
}

Usuario --> UC01
Cliente --> UC02
Cliente --> UC03
Cliente --> UC04
Cliente --> UC05
Cliente --> UC06
Cliente --> UC07
Agente --> UC05
Agente --> UC06
Agente --> UC08
Agente --> UC09
Agente --> UC11
Agente --> UC12
Banco --> UC10
UC10 .> UC09 : <<extend>>
@enduml
